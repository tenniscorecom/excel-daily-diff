{
  // comken の場所を VS Code に教える。ここを書かないと補完も「定義へ移動」も効かない。
  // （実行.bat は動かすときだけ PYTHONPATH を設定するので、編集中の VS Code は別途この指定が要る）
  //
  // 実行.bat と 認証情報の登録.bat の PYTHON_LIBRARY と同じ場所を指すこと。
  // JSON では \ が特殊文字なので、区切りは / で書く（\\server\share → //server/share）。
  // 開発機と社内配置先の両方を並べる。存在しない方は無視されるので、
  // どちらの環境で開いてもそのまま補完と型チェックが効く。
  // 社内だけを書いていると、自宅で開いたとき comken が解決できず
  // エディタだけが「型が Unknown」と言い続ける状態になる。
  "python.analysis.extraPaths": ["F:/dev/comken", "//server/share/tools"],

  // 社内 BO 環境には .venv が無い（pip が使えないため）。
  // その場合はこの指定が外れるので、VS Code 右下の Python バージョン表示をクリックして
  // 社内標準の Python を選ぶ。自宅など .venv を作れる環境ではそのまま使える。
  "python.defaultInterpreterPath": ".venv/Scripts/python.exe",

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.enable": true,
  "editor.rulers": [100]
}