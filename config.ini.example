; =====================================================
; 初回に 実行.bat を1度動かすと、このファイルをもとに config.ini が作られて、
;   「値を書き換えてから、もう一度実行してください」と出て止まります。
;   そのあと config.ini（このファイルではない方）を開いて、実際の値に書き換えてください。
;
; ここに書くもの:
;   **非エンジニアが自分で変える値**（フォルダの場所・絞り込みの語など）。
;   逆に、エンジニアしか触らない固定値は Python コードに書く。config.ini に出すと
;   「触ってよい値」と「触ってはいけない値」が混ざり、どれを変えてよいか分からなくなる。
;   ※ 集計対象月と横軸の期間は、ここからは指定しない（実行時に自動で決まる）。
;
; ルール:
;   - セクション名・キー名は大文字で書く（Python 側の config.SECTION.KEY と一致させる）
;   - 機密情報（パスワード・トークン・メールアドレス等）はここに書かない
;     → 社内の既存の管理方法を使う
;   - config.ini は .gitignore 済み（git に上がらない）。このテンプレートだけ git に含める
;
; ※ 下の値はすべて「書き方の例」です。読み取り元のファイルに合わせて書き換えてください。
; =====================================================


[FILES]
; 一覧_20260812.xlsx のように日付が入ったファイルが並んでいるフォルダ
INPUT_FOLDER = C:\作業\input
; 読み取るファイル名のパターン
FILE_PATTERN = 一覧_*.xlsx

[SOURCE]
; 読み取り元 Excel のシート名。複数書ける（古いファイルはシート名が違うことがあるため、
; 上から順に試して、最初に見つかったシートを使う）。1つだけ書く従来の形もそのまま使える
SHEET_NAME = [案件一覧, Sheet1]
; 見出しが何行目にあるか
HEADER_ROW = 1
; 前日と当日を突き合わせるキー列（1ファイルの中で重複しない列）
KEY_COLUMN = 顧客番号
; 対象月かどうかを見る列（案件そのものの日付。工事の日など）
DATE_COLUMN = 予定日
; 集計表の列グループになる列（下の PLAN_PREFIXES で前方一致させる）
PLAN_COLUMN = 種別
; 完全一致で絞り込む列（下の KINDS と突き合わせる）
KIND_COLUMN = 状態

[FILTER]
; 種別がこの語で始まる行だけを対象にする。集計表の列グループの並び順にもなる
PLAN_PREFIXES = [標準, 上位]
; 状態がこのいずれかに一致する行だけを対象にする
KINDS = [完了, 予定]

[REPORT]
; 出力先はローカルにする（NAS は読み込み元・置き場であり、新規出力先にはしない）
OUTPUT_FOLDER = C:\作業\reports


; ===================================================================
; ここから下は「あとから絞り込みを足す」ための欄。
;
;   書き方 ── 1行につき「列名 = 語」。語はカンマで並べられる
;
;     [EXCLUDE_CONTAINS]
;     地域 = 離島, 山間部
;
;   意味 ──
;     同じ行に並べた語は「どれか1つでも当てはまれば」（OR）
;     列やセクションをまたいだ条件は「すべて満たす行だけ残る」（AND）
;
;   列名は元ファイルの見出しと同じに書くこと。
;   打ち間違えると ExcelColumnNotFoundError で止まる（黙って0件にはならない）。
;   使わないセクションは、丸ごと消しても中身を空のままにしても構わない。
;
;   注意 ── 絞り込み条件を変えると、過去ぶんの数値も本来は変わる。
;   このツールは「いまの条件」を別のテキストファイルに書き出し、
;   起動時に前回と違ったら全期間を作り直す。
; ===================================================================

[EXCLUDE_CONTAINS]
; この列にこの語が含まれる行を、集計から外す
; 例: 地域 = 離島

[INCLUDE_CONTAINS]
; この列にこの語が含まれる行だけを残す
; 例: 担当 = 東京

[EXCLUDE_EXACT]
; この列がこの語と完全に一致する行を、集計から外す
; 例: 状態 = 取消

[INCLUDE_EXACT]
; この列がこの語と完全に一致する行だけを残す
; 例: 支店 = 本店, 東支店