; =====================================================
; 初回に 実行.bat を1度動かすと、このファイルをもとに config.ini が作られて、
;   「値を書き換えてから、もう一度実行してください」と出て止まります。
;   そのあと config.ini（このファイルではない方）を開いて、実際の値に書き換えてください。
;
; ここに書くもの:
;   **非エンジニアが自分で変える値**（フォルダの場所・絞り込みの語など）。
;   逆に、エンジニアしか触らない固定値は Python コードに書く。config.ini に出すと
;   「触ってよい値」と「触ってはいけない値」が混ざり、どれを変えてよいか分からなくなる。
;   ※ 集計対象月と横軸の期間は、ここからは指定しない（実行時に自動で決まる）。
;
; ルール:
;   - セクション名・キー名は大文字で書く（Python 側の config.SECTION.KEY と一致させる）
;   - 機密情報（パスワード・トークン・メールアドレス等）はここに書かない
;     → 社内の既存の管理方法を使う
;   - config.ini は .gitignore 済み（git に上がらない）。このテンプレートだけ git に含める
;
; ※ 下の値はすべて「書き方の例」です。読み取り元のファイルに合わせて書き換えてください。
; =====================================================


[FILES]
; 一覧_20260812.xlsx のように日付が入ったファイルが並んでいるフォルダ
INPUT_FOLDER = C:\作業\input
; 読み取るファイル名のパターン
FILE_PATTERN = 一覧_*.xlsx
; 直近 N 日だけのローリング表示モードに切り替える（任意）。
;   未設定（この行を消す / コメントのまま）→ 既存の年次累積モード。
;     実行年の 1/1 〜 今日まで全部読み、集計.csv の列・行はずっと積み上がる。
;   整数を設定（例: ROLLING_WINDOW_DAYS = 7）→ ローリングモード。
;     今日を含めて直近 N 日ぶんだけを表示する。窓の外に出た業務日列と、
;     窓に登場しなくなった対象月の行は、毎回保存で自動的に消える。
;     1 以上（自然数）の整数を指定。土日祝でファイルが無くても N 暦日ぶんの
;     列を用意する用途に使う（日々サッと確認するルーティン入力用）。
;   業務日の対象月に常に翌月も加えて、翌月分の積み上げを月のどの業務日で
;     も追えるようにする（= 旧仕様の「月末 N 日前からの lookahead」は廃止）。
;     12 月の翌年は翌年 1 月として扱われる（年跨ぎ対応）。
; ROLLING_WINDOW_DAYS = 7

[SOURCE]
; 読み取り元 Excel のシート名（古いファイルはシート名が違うことがあるため、
; 上から順に試して、最初に見つかったシートを使う）。
; 1つだけ書く従来の形もそのまま使える
SHEET_NAME = Sheet1
; 見出しが何行目にあるか
HEADER_ROW = 1
; 前日と当日を突き合わせるキー列（1ファイルの中で重複しない列）
KEY_COLUMN = 顧客番号
; 対象月かどうかを見る列（案件そのものの日付。工事の日など）
DATE_COLUMN = 予定日
; 集計表の列グループになる列（下の PLAN_PREFIXES で前方一致させる）
PLAN_COLUMN = 種別
; 完全一致で絞り込む列（下の KINDS と突き合わせる）
KIND_COLUMN = 状態

[FILTER]
; 種別がこの語で始まる行だけを対象にする。集計表の列グループの並び順にもなる
PLAN_PREFIXES = [標準, 上位]
; 状態がこのいずれかに一致する行だけを対象にする
KINDS = [完了, 予定]

[REPORT]
; 出力先はローカルにする（NAS は読み込み元・置き場であり、新規出力先にはしない）
OUTPUT_FOLDER = C:\作業\reports

;
; ※ 出力 ``集計.csv`` の列構成メモ
;   - 行は **「当月/来月 × 種別 × 判定」の固定構成**。``[FILTER] PLAN_PREFIXES``
;     が既定の ``[標準, 上位]`` のときは 8 行（= 2 対象月 × 2 種別 × 2 判定）。
;     ``PLAN_PREFIXES`` の件数が増える（または減る）と行数もそれに応じて変わる
;     （= 「常に 8 行」ではない）。対象月の値は実際の暦月ではなく、業務日基準の
;     ``当月`` / ``来月`` ラベルが入る
;   - 列構成は ``対象月, 種別, 判定, <日付...>`` の 3 キー列 + 日付列
;   - 列構成や行数が大きく変わったため、**以前の ``集計.csv`` を引き継ぐと
;     行キーが合わずに整合性が崩れる**。このツールを新しい形式で使い始める前は
;     ``OUTPUT_FOLDER`` の ``集計.csv`` を削除して作り直すこと（絞り込み条件を
;     変えたときと同じく、ファイル1本でのやり直しが必要）


; ===================================================================
; ここから下は「あとから絞り込みを足す」ための欄。
;
;   書き方 ── 1行につき「列名 = 語」。語はカンマで並べられる
;
;     [EXCLUDE_CONTAINS]
;     地域 = 離島, 山間部
;
;   意味 ──
;     同じ行に並べた語は「どれか1つでも当てはまれば」（OR）
;     列やセクションをまたいだ条件は「すべて満たす行だけ残る」（AND）
;
;   列名は元ファイルの見出しと同じに書くこと。
;   打ち間違えると ExcelColumnNotFoundError で止まる（黙って0件にはならない）。
;   使わないセクションは、丸ごと消しても中身を空のままにしても構わない。
;
;   注意 ── 絞り込み条件を変えると、過去ぶんの数値も本来は変わる。
;   このツールは条件変更を自動では検知しないので、**全期間を作り直したい
;   場合は ``OUTPUT_FOLDER`` の ``集計.csv`` を消してから実行すること**。
;   出力 ``集計.csv`` の列構成（行・列）が大きく変わったときも、同様に
;   ``集計.csv`` を消してから実行する必要がある（古い形式で行が残ると
;   新しい形式と整合しなくなる）。
; ===================================================================

[EXCLUDE_CONTAINS]
; この列にこの語が含まれる行を、集計から外す
; 例: 地域 = 離島

[INCLUDE_CONTAINS]
; この列にこの語が含まれる行だけを残す
; 例: 担当 = 東京

[EXCLUDE_EXACT]
; この列がこの語と完全に一致する行を、集計から外す
; 例: 状態 = 取消

[INCLUDE_EXACT]
; この列がこの語と完全に一致する行だけを残す
; 例: 支店 = 本店, 東支店
